{
  "name": "fleetboard",
  "version": "0.1.0",
  "private": true,
  "description": "A visual board of real terminals for your AI coding agents.",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "postinstall": "node scripts/postinstall.mjs",
    "app": "bin/fleetboard --rebuild",
    "test": "node scripts/test-unit.mjs",
    "test:e2e": "electron-vite build && xvfb-run -a -s '-screen 0 1600x1000x24' node --enable-source-maps --import ./test/support/register.mjs --test --test-concurrency=1 'test/e2e/**/*.test.ts'",
    "dist:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "oxlint": "^1.89.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.12.0",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^1.59.0",
    "marked": "^18.1.1",
    "nanoid": "^6.0.2",
    "node-pty": "^1.1.0",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "kokoro-js": {
      "@huggingface/transformers": "$@huggingface/transformers"
    }
  },
  "author": {
    "name": "Steezy-code"
  },
  "homepage": "https://github.com/Steezy-code/fleetboard"
}
