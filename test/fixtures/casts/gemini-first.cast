[5.775, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\r\n \u001b[38;2;255;255;175m╭────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[39m\r\n \u001b[38;2;255;255;175m│\u001b[39m                                                                                                \u001b[38;2;255;255;175m│\u001b[39m\r\n \u001b[38;2;255;255;175m│\u001b[39m \u001b[1m\u001b[38;2;255;255;255mDo you trust the files in this folder?\u001b[22m\u001b[39m                                                         \u001b[38;2;255;255;175m│\u001b[39m\r\n \u001b[38;2;255;255;175m│\u001b[39m                                                                                                \u001b[38;2;255;255;175m│\u001b[39m\r\n \u001b[38;2;255;255;175m│\u001b[39m \u001b[38;2;255;255;255mTrusting a folder allows Gemini CLI to load its local configurations, including custom\u001b[39m         \u001b[38;2;255;255;175m│\u001b[39m\r\n \u001b[38;2;255;255;175m│\u001b[39m \u001b[38;2;255;255;255mcommands, hooks, MCP servers, agent skills, and settings. These configurations could execute\u001b[39m   \u001b[38;2;255;255;175m│\u001b[39m\r\n \u001b[38;2;255;255;175m│\u001b[39m \u001b[38;2;255;255;255mcode on your behalf or change the behavior of the CLI.\u001b[39m                                         \u001b[38;2;255;255;175m│\u001b[39m\r\n \u001b[38;2;255;255;175m│\u001b[39m                                                                                                \u001b[38;2;255;255;175m│\u001b[39m\r\n \u001b[38;2;255;255;175m│\u001b[39m                                                                                                \u001b[38;2;255;255;175m│\u001b[39m\r\n \u001b[38;2;255;255;175m│\u001b[39m \u001b[38;2;215;255;215m\u001b[48;2;0;95;0m●\u001b[39m \u001b[38;2;215;255;215m1.\u001b[39m \u001b[38;2;215;255;215mTrust folder (demo2)\u001b[39m   \u001b[49m 