[7.176,"o","\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\r\n \u001b[38;2;71;150;228m▝\u001b[38;2;102;136;217m▜\u001b[38;2;132;122;206m▄\u001b[38;2;164;113;167m \u001b[38;2;195;103;127m \u001b[39m   \u001b[1m\u001b[38;2;255;255;255mGemini CLI\u001b[22m\u001b[38;2;175;175;175m v0.64.0\u001b[39m\r\n \u001b[38;2;71;150;228m \u001b[38;2;102;136;217m \u001b[38;2;132;122;206m▝\u001b[38;2;164;113;167m▜\u001b[38;2;195;103;127m▄\u001b[39m\r\n \u001b[38;2;71;150;228m \u001b[38;2;102;136;217m▗\u001b[38;2;132;122;206m▟\u001b[38;2;164;113;167m▀\u001b[38;2;195;103;127m \u001b[39m   \u001b[38;2;255;255;255mAuthenticated with gemini-api-key\u001b[38;2;175;175;175m /auth\u001b[39m\r\n \u001b[38;2;71;150;228m▝\u001b[38;2;102;136;217m▀\u001b[38;2;132;122;206m \u001b[38;2;153;116;180m \u001b[38;2;174;109;153m \u001b[38;2;195;103;127m \u001b[39m\r\n\r\n\r\n\u001b[38;2;255;255;255mTips for getting started:\u001b[39m\r\n\u001b[38;2;255;255;255m1. Create \u001b[1mGEMINI.md\u001b[22m files to customize your interactions\u001b[39m\r\n\u001b[38;2;255;255;255m2. \u001b[38;2;175;175;175m/help\u001b[38;2;255;255;255m for more information\u001b[39m\r\n\u001b[38;2;255;255;255m3. Ask coding questions, edit code or run commands\u001b[39m\r\n\u001b[38;2;255;255;255m4. Be specific for the best results\u001b[39m\r\n\r\n\u001b[38;2;255;255;175mℹ Skipping project agents due to untrusted folder. To enable, ensure that the project root is\u001b[39m\r\n  \u001b[38;2;255;255;175mtrusted.\u001b[39m\r\n"]
